{
  "name": "nexus-ai-usage",
  "displayName": "Nexus AI Usage (Preview)",
  "description": "Local AI quota monitor for Antigravity, Claude Pro/Max quotas, Enterprise spend and Codex. Independent preview derived from Quota Nexus.",
  "version": "0.1.6",
  "publisher": "nexus-ai-usage-local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/peter821231/nexus-ai-usage.git"
  },
  "homepage": "https://github.com/peter821231/nexus-ai-usage#readme",
  "bugs": {
    "url": "https://github.com/peter821231/nexus-ai-usage/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#11141c",
    "theme": "dark"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "quota",
    "quota monitor",
    "usage",
    "usage limits",
    "usage tracker",
    "ai usage",
    "ai monitor",
    "rate limit",
    "rate limits",
    "token usage",
    "tokens",
    "limits",
    "context window",
    "antigravity",
    "agy",
    "gemini",
    "claude",
    "claude code",
    "anthropic",
    "codex",
    "openai",
    "gpt",
    "status bar",
    "dashboard"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexusAiUsage",
          "title": "Nexus AI Usage",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "nexusAiUsage": [
        {
          "type": "webview",
          "id": "nexusAiUsage.dashboard",
          "name": "Dashboard",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "nexusAiUsage.refresh",
        "title": "Refresh Usage",
        "category": "Nexus AI Usage",
        "icon": "$(refresh)"
      },
      {
        "command": "nexusAiUsage.showDiagnostics",
        "title": "Show Diagnostics",
        "category": "Nexus AI Usage",
        "icon": "$(pulse)"
      },
      {
        "command": "nexusAiUsage.quickSettings",
        "title": "Quick Settings",
        "category": "Nexus AI Usage",
        "icon": "$(settings-gear)"
      },
      {
        "command": "nexusAiUsage.openSettings",
        "title": "Open Settings",
        "category": "Nexus AI Usage",
        "icon": "$(gear)"
      },
      {
        "command": "nexusAiUsage.togglePercentMode",
        "title": "Toggle Used / Remaining",
        "category": "Nexus AI Usage",
        "icon": "$(arrow-both)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nexusAiUsage.refresh",
          "when": "view == nexusAiUsage.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "nexusAiUsage.quickSettings",
          "when": "view == nexusAiUsage.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "nexusAiUsage.showDiagnostics",
          "when": "view == nexusAiUsage.dashboard",
          "group": "more@1"
        },
        {
          "command": "nexusAiUsage.openSettings",
          "when": "view == nexusAiUsage.dashboard",
          "group": "more@2"
        }
      ]
    },
    "configuration": [
      {
        "title": "General",
        "order": 1,
        "properties": {
          "nexusAiUsage.display.percentMode": {
            "type": "string",
            "default": "used",
            "description": "Display quota as used or remaining.",
            "order": 1,
            "enum": [
              "used",
              "left"
            ],
            "enumItemLabels": [
              "Used",
              "Remaining"
            ]
          },
          "nexusAiUsage.refresh.activeInterval": {
            "type": "number",
            "default": 60000,
            "description": "How often to check sources. Claude queries are cached for five minutes.",
            "order": 2,
            "enum": [
              30000,
              60000,
              120000,
              300000
            ],
            "enumItemLabels": [
              "30 seconds",
              "1 minute",
              "2 minutes",
              "5 minutes"
            ]
          },
          "nexusAiUsage.refresh.pauseWhenUnfocused": {
            "type": "boolean",
            "default": true,
            "description": "Pause polling when the editor is in the background.",
            "order": 3
          },
          "nexusAiUsage.context.show": {
            "type": "boolean",
            "default": false,
            "description": "Show conversation context in a separate details section.",
            "order": 4
          },
          "nexusAiUsage.display.timeZone": {
            "type": "string",
            "default": "Asia/Taipei",
            "description": "Timezone for absolute reset and source timestamps.",
            "order": 5,
            "enum": [
              "Asia/Taipei",
              "UTC"
            ]
          }
        }
      },
      {
        "title": "Status Bar",
        "order": 2,
        "properties": {
          "nexusAiUsage.statusBar.show": {
            "type": "boolean",
            "default": true,
            "description": "Show selected usage summaries. Status bar width is limited and shared with other items; hover or open the dashboard for all monitored limits.",
            "order": 1
          }
        }
      },
      {
        "title": "Antigravity",
        "order": 3,
        "properties": {
          "nexusAiUsage.antigravity.enable": {
            "type": "boolean",
            "default": true,
            "description": "Monitor this provider in this extension host.",
            "order": 1
          },
          "nexusAiUsage.antigravity.showInStatusBar": {
            "type": "boolean",
            "default": true,
            "description": "Include this provider in the status bar.",
            "order": 2
          },
          "nexusAiUsage.antigravity.statusBar.geminiFiveHour": {
            "type": "boolean",
            "default": true,
            "description": "Show Gemini Models 5-hour in the status bar. Only changes the selected summary; the hover and dashboard retain all limits. Deselect every window to omit Antigravity from the status bar.",
            "order": 3
          },
          "nexusAiUsage.antigravity.statusBar.geminiWeekly": {
            "type": "boolean",
            "default": true,
            "description": "Show Gemini Models weekly in the status bar. Only changes the selected summary; the hover and dashboard retain all limits. Deselect every window to omit Antigravity from the status bar.",
            "order": 4
          },
          "nexusAiUsage.antigravity.statusBar.claudeGptFiveHour": {
            "type": "boolean",
            "default": false,
            "description": "Show Claude and GPT models 5-hour in the status bar. Only changes the selected summary; the hover and dashboard retain all limits. Deselect every window to omit Antigravity from the status bar.",
            "order": 5
          },
          "nexusAiUsage.antigravity.statusBar.claudeGptWeekly": {
            "type": "boolean",
            "default": false,
            "description": "Show Claude and GPT models weekly in the status bar. Only changes the selected summary; the hover and dashboard retain all limits. Deselect every window to omit Antigravity from the status bar.",
            "order": 6
          },
          "nexusAiUsage.antigravity.statusBar.argonWeekly": {
            "type": "boolean",
            "default": true,
            "description": "Show Gemini 4 Argon weekly in the status bar. Only changes the selected summary; the hover and dashboard retain all limits. Deselect every window to omit Antigravity from the status bar.",
            "order": 7
          }
        }
      },
      {
        "title": "Claude Code",
        "order": 4,
        "properties": {
          "nexusAiUsage.claudeCode.enable": {
            "type": "boolean",
            "default": true,
            "description": "Monitor this provider in this extension host.",
            "order": 1
          },
          "nexusAiUsage.claudeCode.showInStatusBar": {
            "type": "boolean",
            "default": true,
            "description": "Include this provider in the status bar.",
            "order": 2
          },
          "nexusAiUsage.claudeCode.timeoutSeconds": {
            "type": "number",
            "default": 45,
            "description": "Maximum time for the official CLI usage query.",
            "order": 3,
            "enum": [
              15,
              30,
              45,
              60
            ]
          },
          "nexusAiUsage.claudeCode.enterpriseResetSchedule": {
            "type": "string",
            "default": "monthlyUtc",
            "enum": [
              "monthlyUtc",
              "unknown"
            ],
            "enumItemLabels": [
              "Monthly \u00b7 00:00 UTC",
              "Source only / Unknown"
            ],
            "description": "Enterprise spend only: when no source reset is available, use the official monthly rule confirmed against your Usage page. Select Source only if your plan uses a different period. The UI labels rule-derived times.",
            "order": 4
          }
        }
      },
      {
        "title": "Codex",
        "order": 5,
        "properties": {
          "nexusAiUsage.codex.enable": {
            "type": "boolean",
            "default": true,
            "description": "Monitor this provider in this extension host.",
            "order": 1
          },
          "nexusAiUsage.codex.showInStatusBar": {
            "type": "boolean",
            "default": true,
            "description": "Include this provider in the status bar.",
            "order": 2
          }
        }
      }
    ]
  },
  "scripts": {
    "check": "node scripts/check.cjs",
    "test": "node --test test/*.test.js",
    "test:ui": "node scripts/check-webview.cjs",
    "package": "node scripts/package.cjs"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "playwright": "1.65.1"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  }
}

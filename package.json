{
  "name": "nexus-ai-usage",
  "displayName": "%manifest.displayName%",
  "description": "%manifest.description%",
  "version": "0.1.22",
  "publisher": "nexus-ai-usage-local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/peter821231/nexus-ai-usage.git"
  },
  "homepage": "https://github.com/peter821231/nexus-ai-usage#readme",
  "bugs": {
    "url": "https://github.com/peter821231/nexus-ai-usage/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#11141c",
    "theme": "dark"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "quota",
    "quota monitor",
    "usage",
    "usage limits",
    "usage tracker",
    "ai usage",
    "ai monitor",
    "rate limit",
    "rate limits",
    "token usage",
    "tokens",
    "limits",
    "context window",
    "antigravity",
    "agy",
    "gemini",
    "claude",
    "claude code",
    "anthropic",
    "codex",
    "openai",
    "gpt",
    "status bar",
    "dashboard"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexusAiUsage",
          "title": "AI Usage",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "nexusAiUsage": [
        {
          "type": "webview",
          "id": "nexusAiUsage.dashboard",
          "name": "%manifest.view.dashboard%",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "nexusAiUsage.refresh",
        "title": "%manifest.command.refresh%",
        "category": "AI Usage",
        "icon": "$(refresh)"
      },
      {
        "command": "nexusAiUsage.showDiagnostics",
        "title": "%manifest.command.showDiagnostics%",
        "category": "AI Usage",
        "icon": "$(pulse)"
      },
      {
        "command": "nexusAiUsage.quickSettings",
        "title": "%manifest.command.quickSettings%",
        "category": "AI Usage",
        "icon": "$(settings-gear)"
      },
      {
        "command": "nexusAiUsage.openSettings",
        "title": "%manifest.command.openSettings%",
        "category": "AI Usage",
        "icon": "$(gear)"
      },
      {
        "command": "nexusAiUsage.togglePercentMode",
        "title": "%manifest.command.togglePercentMode%",
        "category": "AI Usage",
        "icon": "$(arrow-both)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nexusAiUsage.refresh",
          "when": "view == nexusAiUsage.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "nexusAiUsage.quickSettings",
          "when": "view == nexusAiUsage.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "nexusAiUsage.showDiagnostics",
          "when": "view == nexusAiUsage.dashboard",
          "group": "more@1"
        },
        {
          "command": "nexusAiUsage.openSettings",
          "when": "view == nexusAiUsage.dashboard",
          "group": "more@2"
        }
      ]
    },
    "configuration": [
      {
        "title": "%manifest.group.0%",
        "order": 1,
        "properties": {
          "nexusAiUsage.display.percentMode": {
            "type": "string",
            "default": "used",
            "description": "%manifest.setting.display.percentMode.description%",
            "order": 1,
            "enum": [
              "used",
              "left"
            ],
            "enumItemLabels": [
              "%manifest.setting.display.percentMode.option.0%",
              "%manifest.setting.display.percentMode.option.1%"
            ]
          },
          "nexusAiUsage.refresh.activeInterval": {
            "type": "number",
            "default": 60000,
            "description": "%manifest.setting.refresh.activeInterval.description%",
            "order": 2,
            "enum": [
              30000,
              60000,
              120000,
              300000
            ],
            "enumItemLabels": [
              "%manifest.setting.refresh.activeInterval.option.0%",
              "%manifest.setting.refresh.activeInterval.option.1%",
              "%manifest.setting.refresh.activeInterval.option.2%",
              "%manifest.setting.refresh.activeInterval.option.3%"
            ]
          },
          "nexusAiUsage.refresh.pauseWhenUnfocused": {
            "type": "boolean",
            "default": true,
            "description": "%manifest.setting.refresh.pauseWhenUnfocused.description%",
            "order": 3
          },
          "nexusAiUsage.context.show": {
            "type": "boolean",
            "default": false,
            "description": "%manifest.setting.context.show.description%",
            "order": 4
          },
          "nexusAiUsage.display.timeZone": {
            "type": "string",
            "default": "Asia/Taipei",
            "description": "%manifest.setting.display.timeZone.description%",
            "order": 5,
            "enum": [
              "Asia/Taipei",
              "UTC"
            ]
          },
          "nexusAiUsage.display.language": {
            "type": "string",
            "default": "auto",
            "scope": "window",
            "description": "%manifest.setting.display.language.description%",
            "order": 0,
            "enum": [
              "auto",
              "en",
              "zh-TW"
            ],
            "enumItemLabels": [
              "%manifest.setting.display.language.option.0%",
              "English",
              "繁體中文（台灣）"
            ]
          }
        }
      },
      {
        "title": "%manifest.group.1%",
        "order": 2,
        "properties": {
          "nexusAiUsage.statusBar.show": {
            "type": "boolean",
            "default": true,
            "description": "%manifest.setting.statusBar.show.description%",
            "order": 1
          },
          "nexusAiUsage.statusBar.compact": {
            "type": "boolean",
            "default": false,
            "description": "%manifest.setting.statusBar.compact.description%",
            "order": 2
          }
        }
      },
      {
        "title": "Antigravity",
        "order": 3,
        "properties": {
          "nexusAiUsage.antigravity.enable": {
            "type": "boolean",
            "default": true,
            "description": "%manifest.setting.antigravity.enable.description%",
            "order": 1
          },
          "nexusAiUsage.antigravity.showInStatusBar": {
            "type": "boolean",
            "default": true,
            "description": "%manifest.setting.antigravity.showInStatusBar.description%",
            "order": 2
          },
          "nexusAiUsage.antigravity.statusBar.geminiFiveHour": {
            "type": "boolean",
            "default": true,
            "description": "%manifest.setting.antigravity.statusBar.geminiFiveHour.description%",
            "order": 3
          },
          "nexusAiUsage.antigravity.statusBar.geminiWeekly": {
            "type": "boolean",
            "default": true,
            "description": "%manifest.setting.antigravity.statusBar.geminiWeekly.description%",
            "order": 4
          },
          "nexusAiUsage.antigravity.statusBar.claudeGptFiveHour": {
            "type": "boolean",
            "default": false,
            "description": "%manifest.setting.antigravity.statusBar.claudeGptFiveHour.description%",
            "order": 5
          },
          "nexusAiUsage.antigravity.statusBar.claudeGptWeekly": {
            "type": "boolean",
            "default": false,
            "description": "%manifest.setting.antigravity.statusBar.claudeGptWeekly.description%",
            "order": 6
          },
          "nexusAiUsage.antigravity.statusBar.argonWeekly": {
            "type": "boolean",
            "default": true,
            "description": "%manifest.setting.antigravity.statusBar.argonWeekly.description%",
            "order": 7
          },
          "nexusAiUsage.antigravity.statusBar.otherWindows": {
            "type": "boolean",
            "default": false,
            "description": "%manifest.setting.antigravity.statusBar.otherWindows.description%",
            "order": 8
          }
        }
      },
      {
        "title": "Claude Code",
        "order": 4,
        "properties": {
          "nexusAiUsage.claudeCode.enable": {
            "type": "boolean",
            "default": true,
            "description": "%manifest.setting.claudeCode.enable.description%",
            "order": 1
          },
          "nexusAiUsage.claudeCode.showInStatusBar": {
            "type": "boolean",
            "default": true,
            "description": "%manifest.setting.claudeCode.showInStatusBar.description%",
            "order": 2
          },
          "nexusAiUsage.claudeCode.timeoutSeconds": {
            "type": "number",
            "default": 45,
            "description": "%manifest.setting.claudeCode.timeoutSeconds.description%",
            "order": 3,
            "enum": [
              15,
              30,
              45,
              60
            ]
          },
          "nexusAiUsage.claudeCode.enterpriseResetSchedule": {
            "type": "string",
            "default": "monthlyUtc",
            "enum": [
              "monthlyUtc",
              "unknown"
            ],
            "enumItemLabels": [
              "%manifest.setting.claudeCode.enterpriseResetSchedule.option.0%",
              "%manifest.setting.claudeCode.enterpriseResetSchedule.option.1%"
            ],
            "description": "%manifest.setting.claudeCode.enterpriseResetSchedule.description%",
            "order": 4
          }
        }
      },
      {
        "title": "Codex",
        "order": 5,
        "properties": {
          "nexusAiUsage.codex.enable": {
            "type": "boolean",
            "default": true,
            "description": "%manifest.setting.codex.enable.description%",
            "order": 1
          },
          "nexusAiUsage.codex.showInStatusBar": {
            "type": "boolean",
            "default": true,
            "description": "%manifest.setting.codex.showInStatusBar.description%",
            "order": 2
          }
        }
      }
    ]
  },
  "scripts": {
    "check": "node scripts/check.cjs",
    "test": "node --test test/*.test.js",
    "test:ui": "node scripts/check-webview.cjs",
    "package": "node scripts/package.cjs",
    "locales:check": "node scripts/locales.cjs check",
    "locales:build": "node scripts/locales.cjs build",
    "locales:new": "node scripts/locales.cjs new"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "playwright": "1.65.1"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  }
}
